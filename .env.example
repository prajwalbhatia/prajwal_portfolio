# Copy to .env.local (gitignored) and fill in.
#
# YouTube Data API v3 key. Server-side only — read at build time in
# lib/youtube.ts and never exposed to the browser. Do NOT prefix it with
# NEXT_PUBLIC_, which would inline it into the client bundle.
#
# Without it: the home reels strip is hidden, /reels returns 404, and neither
# appears in the nav or the sitemap. Nothing breaks; the section just isn't there.
#
# Quota cost is 3 units per build against a 10,000/day allowance.
YOUTUBE_API_KEY=
